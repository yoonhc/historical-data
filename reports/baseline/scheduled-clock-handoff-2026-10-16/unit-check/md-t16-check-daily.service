[Unit]
Description=Market data due daily tasks (T13 candidate)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
WorkingDirectory=/home/yoonhc/projects/algoTrade/historical_data
TimeoutStartSec=30min
Restart=on-failure
RestartSec=60s

[Unit]
Requires=md-t16-check-ready.service
After=md-t16-check-ready.service
[Service]

[Service]
User=yoonhc
Environment=PYTHONDONTWRITEBYTECODE=1
ProtectClock=yes
[Service]
ExecStart=/opt/marketdata/releases/scheduled-clock-policy-20261016-544c61aca49f1355/daily/.venv/bin/python -B -I /opt/marketdata/releases/scheduled-clock-policy-20261016-544c61aca49f1355/policy/run_job.py --job daily --binding /etc/marketdata/scheduled-clock-policy/clock-binding.json --state-root /home/yoonhc/projects/algoTrade/historical_data/state/scheduled-clock-policy --run -- run --root /home/yoonhc/projects/algoTrade/historical_data --config /etc/marketdata/daily-scheduler.toml --probe-config /etc/marketdata/daily-publication-probe.toml --report /home/yoonhc/projects/algoTrade/historical_data/state/daily-scheduler-latest.json

[Service]
ExecStart=
ExecStart=/tmp/t16-relocated-qkw41_pc/release/candidate/daily/.venv/bin/python -B -I /home/yoonhc/projects/algoTrade/historical_data/reports/baseline/scheduled-clock-handoff-2026-10-16/trial_worker.py --trial /tmp/t16-relocated-qkw41_pc/release --state /tmp --job daily --local-check
WorkingDirectory=/tmp
Restart=no
ReadOnlyPaths=/home/yoonhc/projects/algoTrade/historical_data /etc/marketdata /var/lib/marketdata-clock /var/lib/marketdata-checkpoint-retirement
PrivateNetwork=yes
