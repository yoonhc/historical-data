[Unit]
Description=Capture recent public five-minute open interest
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=4

[Service]
Type=oneshot
WorkingDirectory=/home/yoonhc/projects/algoTrade/historical_data
ExecStart=/home/yoonhc/projects/algoTrade/historical_data/.venv/bin/marketdata --root . update --config configs/oi-live.toml --report state/oi-latest.json
TimeoutStartSec=4min
Restart=on-failure
RestartSec=30s

[Unit]
Requires=marketdata-clock-ready.service
After=marketdata-clock-ready.service
[Service]
ExecStartPre=/opt/marketdata/releases/system-bootstrap-20261007-f85eb8321a19c1ee/.venv/bin/python -I /opt/marketdata/releases/system-bootstrap-20261007-f85eb8321a19c1ee/integrations/runtime/clock_gate.py check --profile /etc/marketdata/clock-bootstrap.json

[Service]
User=yoonhc
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=
ExecStart=/home/yoonhc/projects/algoTrade/historical_data/reports/baseline/scheduled-system-migration-2026-10-12/candidate/.venv/bin/python -B -I -m marketdata --root /home/yoonhc/projects/algoTrade/historical_data update --config /etc/marketdata/scheduled-system/oi-live.toml --report state/oi-latest.json
ProtectClock=yes
