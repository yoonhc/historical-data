+def stamp(t, wall=None, boot=None):
+    return {
+        "wall_ns": int((100000 + t if wall is None else wall) * 1e9),
+        "monotonic_ns": int(t * 1e9),
+        "boottime_ns": int((t if boot is None else boot) * 1e9),
+        "sampling_span_ns": 500,
+    }
