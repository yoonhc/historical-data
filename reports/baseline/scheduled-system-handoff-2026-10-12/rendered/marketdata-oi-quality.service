[Unit]
Description=Generate daily OI parity and availability evidence

[Service]
Type=oneshot
WorkingDirectory=/home/yoonhc/projects/algoTrade/historical_data
ExecStart=/home/yoonhc/projects/algoTrade/historical_data/.venv/bin/marketdata --root . oi-quality --days 7
TimeoutStartSec=5min
# A completed report can contain findings requiring review.
SuccessExitStatus=2

[Unit]
Requires=marketdata-clock-ready.service
After=marketdata-clock-ready.service
[Service]
ExecStartPre=/opt/marketdata/releases/system-bootstrap-20261007-f85eb8321a19c1ee/.venv/bin/python -I /opt/marketdata/releases/system-bootstrap-20261007-f85eb8321a19c1ee/integrations/runtime/clock_gate.py check --profile /etc/marketdata/clock-bootstrap.json

[Service]
User=yoonhc
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=
ExecStart=/opt/marketdata/releases/scheduled-manager-20261012-255d64b78ffa8328/.venv/bin/python -B -I -m marketdata.cli --root /home/yoonhc/projects/algoTrade/historical_data oi-quality --days 7
ProtectClock=yes
