      "text": "[Unit]\nDescription=Market data %i collector with sampled clock quality\nWants=network-online.target chrony.service chrony-wait.service marketdata-clock-bootstrap.service\nAfter=network-online.target chrony.service marketdata-clock-bootstrap.service chrony-wait.service time-sync.target\nRequiresMountsFor=/home/yoonhc/projects/algoTrade/historical_data /opt/marketdata/releases/system-bootstrap-20261007-f85eb8321a19c1ee /home/yoonhc/projects/algoTrade/historical_data/state/runtime-clock\nStartLimitIntervalSec=0\n\n[Service]\nType=exec\nUser=yoonhc\nWorkingDirectory=/opt/marketdata/releases/system-bootstrap-20261007-f85eb8321a19c1ee\nEnvironment=PYTHONNOUSERSITE=1\nEnvironment=PYTHONDONTWRITEBYTECODE=1\nExecStartPre=/opt/marketdata/releases/system-bootstrap-20261007-f85eb8321a19c1ee/.venv/bin/python -I /opt/marketdata/releases/system-bootstrap-20261007-f85eb8321a19c1ee/integrations/runtime/clock_gate.py check --profile /etc/marketdata/clock-bootstrap.json\nExecStartPre=/opt/marketdata/releases/system-bootstrap-20261007-f85eb8321a19c1ee/.venv/bin/python -I /opt/marketdata/releases/system-bootstrap-20261007-f85eb8321a19c1ee/integrations/runtime/marketdata_runtime.py wait-ready --profile /etc/marketdata/runtime.json --stream %i\nExecStart=/opt/marketdata/releases/system-bootstrap-20261007-f85eb8321a19c1ee/.venv/bin/python -I /opt/marketdata/releases/system-bootstrap-20261007-f85eb8321a19c1ee/integrations/runtime/marketdata_runtime.py run --profile /etc/marketdata/runtime.json --stream %i\nRestart=always\nRestartSec=15s\nTimeoutStartSec=150s\nTimeoutStopSec=150s\nKillSignal=SIGINT\nKillMode=mixed\nSendSIGKILL=yes\nUMask=0077\nNoNewPrivileges=yes\nCapabilityBoundingSet=\nProtectClock=yes\nProtectSystem=strict\nProtectHome=read-only\nReadWritePaths=/home/yoonhc/projects/algoTrade/historical_data /home/yoonhc/projects/algoTrade/historical_data/state/runtime-clock\nPrivateTmp=yes\nRestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK\nStandardOutput=journa