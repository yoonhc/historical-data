+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("boot", ROOT / "integrations/runtime/clock_gate.py")
+boot = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(boot)
