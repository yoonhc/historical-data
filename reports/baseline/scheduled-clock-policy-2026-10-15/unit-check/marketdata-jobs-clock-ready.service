[Unit]
Description=Scheduled job clock observation and same-boot preparation
After=network-online.target
[Service]
Type=oneshot
User=yoonhc
ExecStart=/home/yoonhc/projects/algoTrade/historical_data/reports/baseline/scheduled-clock-policy-2026-10-15/candidate/base/.venv/bin/python -B -I /home/yoonhc/projects/algoTrade/historical_data/reports/baseline/scheduled-clock-policy-2026-10-15/candidate/policy/run_job.py --job oi --binding /etc/marketdata/scheduled-clock-policy/clock-binding.json --wait
TimeoutStartSec=infinity
RemainAfterExit=no
ProtectClock=yes
Environment=PYTHONDONTWRITEBYTECODE=1
