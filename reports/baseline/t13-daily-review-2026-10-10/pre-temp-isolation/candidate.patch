+
+def fill_old(store, runner, key, day=DAY0):
+    Collector(store, Fetcher(client=runner.client, sleep=lambda _: None), cooperative=True).archive(
+        key, utc(day), utc(day) + DAY, monthly=False, refresh=True
+    )
