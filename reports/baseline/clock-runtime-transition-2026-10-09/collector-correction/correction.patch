+def test_final_observation_is_sampled_after_provider_query(profile):
+    timer, evidence = Timer(), Memory()
+
+    class Child:
+        pid = os.getpid()
+        returncode = 0
+
+        def poll(self):
+            return 0
+
+    def checker(_):
+        # Real provider queries finish after the call begins. The final sample
+        # must be taken after this observation, as it is for ordinary loop probes.
+        timer.t += 0.01
+        return clock(profile, timer.t)
+
+    result = cr.supervise(
+        profile,
+        "depth",
+        evidence,
+        timer,
+        {"ready": True},
+        checker=checker,
+        env_check=lambda _: "fixture",
+        spawn=lambda *a, **k: Child(),
+        stamp=lambda: stamp(timer.t),
+        monotonic=lambda: timer.t,
+        max_children=1,
+    )
+    assert result == 0
+    final = evidence.rows[-1]
+    assert final["state"] == "finished"
+    assert final["decision"]["reasons"] == []
+    assert final["decision"]["current_estimate_usable"]
+    assert not final["history"]["hard_fault_seen"]
