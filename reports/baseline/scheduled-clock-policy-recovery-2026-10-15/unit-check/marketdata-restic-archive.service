[Unit]
Description=Parallel restic archive of completed marketdata checkpoints

[Service]
Type=oneshot
WorkingDirectory=/home/yoonhc
EnvironmentFile=/home/yoonhc/.config/marketdata/restic-service.env
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
KillSignal=SIGINT
TimeoutStopSec=120s
Restart=no
StandardOutput=journal
StandardError=journal

[Unit]
Requires=marketdata-jobs-clock-ready.service
After=marketdata-jobs-clock-ready.service
[Service]

[Service]

[Service]
User=yoonhc
Environment=PYTHONDONTWRITEBYTECODE=1
ProtectClock=yes
[Service]
ExecStart=/home/yoonhc/projects/algoTrade/historical_data/reports/baseline/scheduled-clock-policy-recovery-2026-10-15/candidate/preserve/.venv/bin/python -B -I /home/yoonhc/projects/algoTrade/historical_data/reports/baseline/scheduled-clock-policy-recovery-2026-10-15/candidate/policy/run_job.py --job restic-archive --binding /etc/marketdata/scheduled-clock-policy/clock-binding.json --state-root /home/yoonhc/projects/algoTrade/historical_data/state/scheduled-clock-policy --run -- --profile /home/yoonhc/.config/marketdata/restic-archive.toml run
