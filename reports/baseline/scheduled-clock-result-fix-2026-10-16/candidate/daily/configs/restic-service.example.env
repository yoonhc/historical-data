# Copy to ~/.config/marketdata/restic-service.env on the collecting host/VM.
# These are paths, not shell commands. No password value belongs in this file.
MARKETDATA_PYTHON=/srv/marketdata/app/.venv/bin/python
MARKETDATA_RESTIC_PROFILE=/home/collector/.config/marketdata/restic-archive.toml
PYTHONPATH=/srv/marketdata/app
