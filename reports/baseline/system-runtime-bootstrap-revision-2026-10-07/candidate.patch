+def wait_for_gate(
+    checker, stop, *, poll_seconds=5.0, long_wait_seconds=600.0, monotonic=time.monotonic, emit=None
+):
+    """Read-only dependency barrier; no business work, clock writes or success receipt.
+
+    Waiting lives in its own oneshot, outside each job's timeout/start-limit budget.
+    Every invocation checks current readiness; it is deliberately not RemainAfterExit.
+    Ordinary not-ready/errors stay pending. Explicit cancellation is unsuccessful.
+    """
+    if emit is None:
+
+        def emit(event):
+            print(json.dumps(event, sort_keys=True), flush=True)
+
+    started = monotonic()
+    while not stop.is_set():
+        try:
+            result = checker()
+            if not result.get("ready"):
+                raise Hold("Clock gate returned not ready")
+        except (
+            Hold,
+            rt.NotReady,
+            OSError,
+            ValueError,
+            KeyError,
+            subprocess.SubprocessError,
+        ) as exc:
+            elapsed = max(0.0, monotonic() - started)
+            emit(
+                {
+                    "ready": False,
+                    "phase": "waiting",
+                    "reason": str(exc),
+                    "wait_seconds": elapsed,
+                    "long_wait": elapsed >= long_wait_seconds,
+                }
+            )
+            stop.wait(poll_seconds)  # No ledger lock is held here.
+            continue
+        if stop.is_set():
+            break
+        emit({"ready": True, "phase": "released", "wait_seconds": max(0.0, monotonic() - started)})
+        return 0
+    emit({"ready": False, "phase": "cancelled", "wait_seconds": max(0.0, monotonic() - started)})
+    return 75
