[Unit]
Description=Capture recent public five-minute open interest
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/yoonhc/projects/algoTrade/historical_data
ExecStart=/home/yoonhc/projects/algoTrade/historical_data/.venv/bin/marketdata --root . update --config configs/oi-live.toml
TimeoutStartSec=4min
