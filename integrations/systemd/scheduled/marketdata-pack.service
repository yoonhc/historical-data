[Unit]
Description=Market data hourly verified maintenance
StartLimitIntervalSec=3600
StartLimitBurst=4
Requires=marketdata-jobs-clock-ready.service
After=marketdata-jobs-clock-ready.service

[Service]
Type=oneshot
WorkingDirectory=@STORE_ROOT@
TimeoutStartSec=6h
KillSignal=SIGINT
TimeoutStopSec=120s
Restart=on-failure
RestartSec=120s
User=@USER@
Environment=PYTHONDONTWRITEBYTECODE=1
ProtectClock=yes
ExecStart=@RELEASE@/.venv/bin/python -B -I @RELEASE@/scripts/run_job.py --job pack --binding @CONFIG_ROOT@/scheduled-clock-policy/clock-binding.json --state-root @STORE_ROOT@/state/scheduled-clock-policy --run -- --root @STORE_ROOT@ maintenance --mode hourly --min-free-gib 10 --wait-for-lock
