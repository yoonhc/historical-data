[Unit]
Description=Market data hourly verified maintenance
StartLimitIntervalSec=3600
StartLimitBurst=4

[Service]
Type=oneshot
WorkingDirectory=/home/yoonhc/projects/algoTrade/historical_data
ExecStart=/home/yoonhc/projects/algoTrade/historical_data/.venv/bin/marketdata --root . maintenance --mode hourly --min-free-gib 10
TimeoutStartSec=6h
KillSignal=SIGINT
TimeoutStopSec=120s
Restart=on-failure
RestartSec=120s
